# Ferrari (21631/216AC): SM8450, Synaptics S3908 I2C, SN100T and Goodix G7
CONFIG_PHY_QCOM_UFS_V4_WAIPIO=m
CONFIG_OPLUS_CHG=m
CONFIG_OPLUS_CHG_DYNAMIC_CONFIG=y
CONFIG_OPLUS_SM8450_CHARGER=y
CONFIG_NXP_NFC_I2C=m
CONFIG_OPLUS_THERMAL_WAIPIO=m
CONFIG_OPLUS_FEATURE_SENSOR_CFG=m
CONFIG_OPLUS_SENSOR_FB_QC=m
CONFIG_SSC_INTERACTIVE=m
CONFIG_OPLUS_SENSOR_DRM_PANEL_NOTIFY=y
CONFIG_OPLUS_SENSOR_DRM_PANEL_ADFR_MIN_FPS=y
CONFIG_OPLUS_RF_CABLE_MONITOR=m
CONFIG_TOUCHPANEL_OPLUS=m
CONFIG_TOUCHPANEL_CUSTOM=m
CONFIG_TOUCHPANEL_LATE_INIT=y
CONFIG_TOUCHPANEL_SYNAPTICS=m
CONFIG_TOUCHPANEL_SYNAPTICS_TCM_ONCELL=m
CONFIG_OPLUS_FINGERPRINT=y
CONFIG_OPLUS_FINGERPRINT_COMMON=m
CONFIG_OPLUS_FINGERPRINT_QCOM=y
CONFIG_OPLUS_FINGERPRINT_GOODIX_OPTICAL=m
CONFIG_DRM_PANEL_NOTIFY_FINGERPRINT=m
